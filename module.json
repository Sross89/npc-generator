{
  "id": "npc-generator",
  "title": "NPC Generator",
  "description": "Generate a fully-fleshed-out NPC — stat block, quirk, ideal, bond, flaw, name, and inventory — from a base template in one click.",
  "version": "0.2.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Simon Ross"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "wormsworth-content-library",
        "type": "module",
        "compatibility": {
          "verified": "0.1.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/npc-generator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/Sross89/npc-generator",
  "manifest": "https://raw.githubusercontent.com/Sross89/npc-generator/master/module.json",
  "download": "https://github.com/Sross89/npc-generator/releases/latest/download/module.zip",
  "readme": "README.md",
  "license": "LICENSE",
  "bugs": "https://github.com/Sross89/npc-generator/issues"
}
