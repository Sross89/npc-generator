{
  "id": "npc-generator",
  "title": "NPC Generator",
  "description": "Generate a fully-fleshed-out NPC — stat block, quirk, ideal, bond, flaw, name, and inventory — from a base template in one click.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Simon Ross"
    }
  ],
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/npc-generator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "npc-templates",
      "label": "NPC Templates",
      "system": "dnd5e",
      "path": "packs/npc-templates",
      "type": "Actor"
    },
    {
      "name": "trinket-items",
      "label": "Trinkets & Oddities (Items)",
      "system": "dnd5e",
      "path": "packs/trinket-items",
      "type": "Item"
    },
    {
      "name": "roll-tables",
      "label": "NPC Generator Roll Tables",
      "path": "packs/roll-tables",
      "type": "RollTable"
    }
  ],
  "url": "https://github.com/Sross89/npc-generator",
  "manifest": "https://raw.githubusercontent.com/Sross89/npc-generator/master/module.json",
  "download": "https://github.com/Sross89/npc-generator/releases/latest/download/module.zip",
  "readme": "README.md",
  "license": "LICENSE",
  "bugs": "https://github.com/Sross89/npc-generator/issues"
}
