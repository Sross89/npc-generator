<div class="inventory-row" data-row="{{key}}">
  <span class="item-name">{{name}}</span>
  <button type="button" data-action="reroll" data-row="{{key}}" title="{{localize 'NPC_GENERATOR.Generator.Reroll'}}">
    <i class="fa-solid fa-dice"></i>
  </button>
  <button type="button" data-action="removeRow" data-row="{{key}}" title="{{localize 'NPC_GENERATOR.Generator.Remove'}}">
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>
